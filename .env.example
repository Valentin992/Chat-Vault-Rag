# Copy this file to `.env` and paste your real keys.
# `.env` is in .gitignore — it is NEVER committed.

# ── Your vault ──────────────────────────────────────────────────────────
# Absolute path to your Obsidian vault (or any folder of .md files).
# You can also pass it as an argument: python chunk_vault.py "D:/my/vault"
VAULT_PATH=C:/path/to/your/vault

# Optional: extra folders to skip, comma-separated (.obsidian/.trash/.git are
# always skipped). Example: SKIP_DIRS=Templates,Archive,Daily Notes
# SKIP_DIRS=

# ── API keys ────────────────────────────────────────────────────────────
# Embeddings (OpenAI). Create at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Answer generation (Claude). Create at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional overrides (sensible defaults if left unset) ────────────────
# EMBED_MODEL=text-embedding-3-small
# GEN_MODEL=claude-opus-4-8
# TOP_K=8
# DEMO_QUERY=                 # set to auto-run a search after building the index
