# Copia este archivo a `.env` y pega tus claves reales.
# `.env` está en .gitignore — NUNCA se sube a GitHub.

# Paso 1 — ruta local al vault. También puedes pasarla como argumento al script.
VAULT_PATH=C:/path/to/your/vault

# Paso 2 — embeddings (OpenAI). Crear en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Paso 5 — generación de la respuesta (Claude). Crear en:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
